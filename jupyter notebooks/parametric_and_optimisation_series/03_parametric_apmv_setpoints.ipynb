   "cell_type": "raw",
   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": \"# 03 - Parametric APMV setpoints\\n\\nGoal: run a complete APMV parametric workflow with `parameters_type='apmv setpoints'`.\\n\\n## Methods executed in this notebook\\n\\nCore ACCIM/BESOS functions used in the runnable flow:\\n- `accim.utils.reduce_runtime`\\n- `ef.get_building`\\n- `ParametricSimulation.discover_available_outputs`\\n- `ParametricSimulation.select_outputs`\\n- `ParametricSimulation.apply_outputs_preflight`\\n- `ParametricSimulation.set_outputs_for_simulation`\\n- `ParametricSimulation.set_parameters`\\n- `ParametricSimulation.set_problem`\\n- `ParametricSimulation.sampling_full_set`\\n- `ParametricSimulation.run_parametric_simulation`\\n\\nWorkspace hygiene helpers used:\\n- `WorkspaceArtifactCleaner.capture_initial_state`\\n- `WorkspaceArtifactCleaner.print_generated_files`\\n- `WorkspaceArtifactCleaner.delete_generated_files`\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": \"## Step 1 - Import dependencies\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": \"from pathlib import Path\\n\\nimport accim\\nimport pandas as pd\\nfrom besos import eppy_funcs as ef\\nfrom accim.sim import apmv_setpoints\\nfrom accim.utils import WorkspaceArtifactCleaner\\nfrom accim.parametric_and_optimisation.main import ParametricSimulation\\n\\npd.set_option(\\\"display.max_columns\\\", 160)\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": \"## Step 2 - Define paths and validate files\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": \"PROJECT_ROOT = Path.cwd()\\nNOTEBOOK_DIR = Path(__file__).resolve().parent\\n\\n\\nIDF_FILE = PROJECT_ROOT / \\\"OSM_TestResidentialUnit_v01_onlygeometry_SchNatVent_v2520_high_performance.idf\\\"\\nif not IDF_FILE.exists():\\n\\tIDF_FILE = NOTEBOOK_DIR / \\\"OSM_TestResidentialUnit_v01_onlygeometry_SchNatVent_v2520_high_performance.idf\\\"\\n\\nepw_seville = PROJECT_ROOT / \\\"Seville.epw\\\"\\nif not epw_seville.exists():\\n\\tepw_seville = NOTEBOOK_DIR / \\\"Seville.epw\\\"\\n\\nEPWS = [str(epw_seville)]\\nRESULTS_DIRNAME = \\\"nb03_parametric_apmv_results\\\"\\n\\nprint(\\\"IDF exists:\\\", IDF_FILE.exists())\\nprint(\\\"EPWs exist:\\\", [Path(epw).exists() for epw in EPWS])\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": \"## Step 2.1 - Initialize artifact tracking\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": \"artifact_cleaner = WorkspaceArtifactCleaner(workspace_root=PROJECT_ROOT)\\nbaseline_files = artifact_cleaner.capture_initial_state()\\nprint(\\\"Baseline file count:\\\", len(baseline_files))\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": \"## Step 3 - Load IDF and initialize APMV simulation object\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": \"building = ef.get_building(str(IDF_FILE))\\naccim.utils.reduce_runtime(idf_object=building, timesteps=2)\\n# Ensure the model contains the HVAC structure expected by aPMV routines.\\napmv_setpoints.add_vrf_system(building=building)\\n\\nparametric = ParametricSimulation(\\n\\tbuilding=building,\\n\\tparameters_type=\\\"apmv setpoints\\\",\\n\\tepws=EPWS,\\n\\toutput_freqs=[\\\"hourly\\\"],\\n)\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": \"## Step 4 - Discover outputs and configure objective outputs\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": \"discovery = parametric.discover_available_outputs(\\n\\treduce_sim_time=True,\\n\\tprefer=\\\"testsimeplus\\\",\\n)\\ndf_meters_available = discovery[\\\"meters\\\"]\\ndf_vars_available = discovery[\\\"variables\\\"]\\noutputs_meta = discovery[\\\"meta\\\"]\\nprint(\\\"Discovery source:\\\", outputs_meta.get(\\\"source\\\"))\\nprint(\\\"Meters available:\\\", len(df_meters_available))\\nprint(\\\"Variables available:\\\", len(df_vars_available))\\n\\nselection = parametric.select_outputs(\\n\\tmeters=[\\\"Heating:Electricity\\\", \\\"Cooling:Electricity\\\"],\\n\\tvariables=[\\\"aPMV\\\"],\\n\\tmatch=\\\"contains\\\",\\n\\ton_missing=\\\"warn\\\",\\n\\tsuggest=True,\\n)\\ndf_meters_sel = selection[\\\"meters\\\"]\\ndf_vars_sel = selection[\\\"variables\\\"]\\nreport = selection[\\\"report\\\"]\\nprint(\\\"Missing outputs:\\\", report.get(\\\"missing\\\", {}))\\n\\nparametric.apply_outputs_preflight(\\n\\tdf_meters_sel=df_meters_sel,\\n\\tdf_vars_sel=df_vars_sel,\\n\\tclean_mode=\\\"all\\\",\\n\\tvalidate_before_apply=False,\\n\\tvalidate_after_apply=True,\\n\\ton_missing=\\\"warn\\\",\\n)\\nparametric.set_outputs_for_simulation(df_output_meter=df_meters_sel)\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": \"## Step 5 - Define APMV parameters and generate full-set plan\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": \"apmv_parameters = {\\n\\t\\\"Adaptive coefficient\\\": [0.0, 0.9],\\n\\t\\\"PMV setpoint\\\": [0.2, 0.8],\\n}\\nparametric.set_parameters(accis_params_dict=apmv_parameters)\\nparametric.set_problem()\\nparametric.sampling_full_set()\\n\\nplan_df = parametric.parameters_values_df.copy()\\nprint(\\\"Plan rows:\\\", len(plan_df))\\nprint(plan_df.head())\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": \"## Step 5.1 - Estimate number of simulation cases\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": \"epw_multiplier = 1 if \\\"epw\\\" in plan_df.columns else len(EPWS)\\nestimated_simulations = len(plan_df) * epw_multiplier\\n\\nprint(\\\"EPW multiplier:\\\", epw_multiplier)\\nprint(\\\"Estimated simulation cases:\\\", estimated_simulations)\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": \"## Step 6 - Execute APMV parametric simulation\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": \"RUN_PARAMETRIC_SIMULATION = True\\n\\nif RUN_PARAMETRIC_SIMULATION:\\n\\toutputs = parametric.run_parametric_simulation(\\n\\t\\tout_dir=str(PROJECT_ROOT / RESULTS_DIRNAME),\\n\\t\\tdf=plan_df,\\n\\t\\tprocesses=1,\\n\\t\\tkeep_input=True,\\n\\t\\tkeep_dirs=False,\\n\\t)\\n\\tprint(\\\"Rows:\\\", len(outputs))\\n\\tprint(outputs.head())\\nelse:\\n\\tprint(\\\"Simulation skipped. Set RUN_PARAMETRIC_SIMULATION = True to execute the run.\\\")\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": \"## Step 7 - Review and clean generated artifacts\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": \"generated_files = artifact_cleaner.print_generated_files(max_items=200)\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": \"artifact_cleaner.delete_generated_files(\\n\\tallow_patterns=[f\\\"{RESULTS_DIRNAME}/**\\\"],\\n\\tdeny_patterns=[],\\n\\tdry_run=True,\\n\\tremove_empty_dirs=True,\\n)\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": \"artifact_cleaner.delete_generated_files(\\n\\tallow_patterns=[f\\\"{RESULTS_DIRNAME}/**\\\"],\\n\\tdeny_patterns=[],\\n\\tdry_run=False,\\n\\tremove_empty_dirs=True,\\n)\"\n",
    "  }\n",
    " ],\n",
