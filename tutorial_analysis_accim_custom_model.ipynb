   "cell_type": "raw",
   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# Tutorial: OptimisationSimulation with parameters_type='accim custom model' - Analysis Part\\n\",\n",
    "    \"\\n\",\n",
    "    \"This notebook covers loading previous optimization results and running multi-criteria decision making (MCDM),\\n\",\n",
    "    \"Pareto-front plotting, design clustering, robustness analysis, and sensitivity analysis.\\n\",\n",
    "    \"\\n\",\n",
    "    \"Workflow:\\n\",\n",
    "    \"  1. Load and prepare the IDF.\\n\",\n",
    "    \"  2. Instantiate OptimisationSimulation.\\n\",\n",
    "    \"  3. Discover, select and apply outputs (to configure the problem and allow simulation-based post-processing).\\n\",\n",
    "    \"  4. Define ACCIM custom-model parameters.\\n\",\n",
    "    \"  5. Define the optimisation problem.\\n\",\n",
    "    \"  6. Load previous results.\\n\",\n",
    "    \"  7. Analyse Pareto front (inspect flags, MCDM, plots, clustering).\\n\",\n",
    "    \"  8. Optional robustness and sensitivity analysis.\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# 0. Imports and user settings\\n\",\n",
    "    \"We import packages and set up variables. We comment out `matplotlib.use(\\\"Agg\\\")` to allow plots to render inline in Jupyter.\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"import os\\n\",\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"\\n\",\n",
    "    \"import matplotlib\\n\",\n",
    "    \"\\n\",\n",
    "    \"# matplotlib.use(\\\"Agg\\\") # Commented out to display plots inline in Jupyter Notebook\\n\",\n",
    "    \"matplotlib.rcParams[\\\"figure.dpi\\\"] = 150\\n\",\n",
    "    \"\\n\",\n",
    "    \"import accim\\n\",\n",
    "    \"from accim.parametric_and_optimisation.main import OptimisationSimulation\\n\",\n",
    "    \"from besos import eppy_funcs as ef\\n\",\n",
    "    \"\\n\",\n",
    "    \"PROJECT_DIR = Path.cwd()\\n\",\n",
    "    \"os.chdir(PROJECT_DIR)\\n\",\n",
    "    \"\\n\",\n",
    "    \"IDF_FILE = \\\"OSM_TestResidentialUnit_v01_onlygeometry_SchNatVent_v2520.idf\\\"\\n\",\n",
    "    \"EPW_LIST = [\\\"Seville.epw\\\", \\\"Sydney.epw\\\"]\\n\",\n",
    "    \"OUT_DIR = \\\"tutorial_optim_accim_custom_model\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Set this to a path string if you want to load a specific pickle file.\\n\",\n",
    "    \"# Otherwise, it automatically finds the latest pickle in OUT_DIR.\\n\",\n",
    "    \"OPTIMISATION_PICKLE = None\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# 1. Load and prepare the EnergyPlus model\\n\",\n",
    "    \"We load the building geometry from the IDF file. This is required for simulation-based post-processing (e.g. robustness analysis).\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"building = ef.get_building(IDF_FILE)\\n\",\n",
    "    \"\\n\",\n",
    "    \"accim.utils.set_occupancy_to_always(idf_object=building)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Keep the tutorial fast. Remove or relax this line for production runs.\\n\",\n",
    "    \"# accim.utils.reduce_runtime(idf_object=building, timesteps=2)\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# 2. Instantiate OptimisationSimulation\\n\",\n",
    "    \"We instantiate the class using the building model and custom adaptive comfort parameters.\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"parametric = OptimisationSimulation(\\n\",\n",
    "    \"    building=building,\\n\",\n",
    "    \"    parameters_type=\\\"accim custom model\\\",\\n\",\n",
    "    \"    epws=EPW_LIST,\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# 3. Discover available outputs\\n\",\n",
    "    \"Discover the meters and variables in the model.\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"discovery = parametric.discover_available_outputs(\\n\",\n",
    "    \"    reduce_sim_time=True,\\n\",\n",
    "    \"    prefer=\\\"testsimeplus\\\",\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"df_meters_available = discovery[\\\"meters\\\"]\\n\",\n",
    "    \"df_vars_available = discovery[\\\"variables\\\"]\\n\",\n",
    "    \"outputs_meta = discovery[\\\"meta\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Discovery source:\\\", outputs_meta.get(\\\"source\\\"))\\n\",\n",
    "    \"print(\\\"Available meters:\\\", len(df_meters_available))\\n\",\n",
    "    \"print(\\\"Available variables:\\\", len(df_vars_available))\\n\",\n",
    "    \"\\n\",\n",
    "    \"df_meters_available.head()\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# 4. Select the outputs for this optimisation\\n\",\n",
    "    \"Select Heating and Cooling electricity objectives, and auxiliary variables.\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"objective_meters = [\\n\",\n",
    "    \"    \\\"Heating:Electricity\\\",\\n\",\n",
    "    \"    \\\"Cooling:Electricity\\\",\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"auxiliary_variables = [\\n\",\n",
    "    \"    \\\"Setpoint Temperature_No Tolerance\\\",\\n\",\n",
    "    \"    \\\"Zone Operative Temperature\\\",\\n\",\n",
    "    \"    \\\"Running Average Outdoor Air Temperature\\\",\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"meters_selection = parametric.select_outputs(\\n\",\n",
    "    \"    meters=objective_meters,\\n\",\n",
    "    \"    match=\\\"case_insensitive\\\",\\n\",\n",
    "    \"    on_missing=\\\"raise\\\",\\n\",\n",
    "    \"    suggest=True,\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"df_meters_sel = meters_selection[\\\"meters\\\"]\\n\",\n",
    "    \"meters_report = meters_selection[\\\"report\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"variables_selection = parametric.select_outputs(\\n\",\n",
    "    \"    variables=auxiliary_variables,\\n\",\n",
    "    \"    match=\\\"contains\\\",\\n\",\n",
    "    \"    on_missing=\\\"warn\\\",\\n\",\n",
    "    \"    suggest=True,\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"df_vars_sel = variables_selection[\\\"variables\\\"]\\n\",\n",
    "    \"variables_report = variables_selection[\\\"report\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Selected objective meters:\\\", len(df_meters_sel))\\n\",\n",
    "    \"print(\\\"Selected auxiliary variables:\\\", len(df_vars_sel))\\n\",\n",
    "    \"\\n\",\n",
    "    \"if variables_report[\\\"missing\\\"][\\\"variables\\\"]:\\n\",\n",
    "    \"    print(\\\"Missing auxiliary variables:\\\", variables_report[\\\"missing\\\"][\\\"variables\\\"])\\n\",\n",
    "    \"    print(\\\"Suggestions:\\\", variables_report[\\\"suggestions\\\"][\\\"variables\\\"])\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# 5. Apply the selected outputs to the IDF\\n\",\n",
    "    \"Clear stale output objects, apply the selected ones, and set the simulation outputs.\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"preflight_report = parametric.apply_outputs_preflight(\\n\",\n",
    "    \"    df_meters_sel=df_meters_sel,\\n\",\n",
    "    \"    df_vars_sel=df_vars_sel,\\n\",\n",
    "    \"    clean_mode=\\\"all\\\",\\n\",\n",
    "    \"    validate_before_apply=False,\\n\",\n",
    "    \"    validate_after_apply=True,\\n\",\n",
    "    \"    on_missing=\\\"raise\\\",\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Meters missing in IDF:\\\", len(preflight_report[\\\"verification\\\"][\\\"meters\\\"][\\\"missing_in_idf\\\"]))\\n\",\n",
    "    \"print(\\\"Variables missing in IDF:\\\", len(preflight_report[\\\"verification\\\"][\\\"vars\\\"][\\\"missing_in_idf\\\"]))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Only the objective meters are passed to BESOS as optimisation outputs.\\n\",\n",
    "    \"parametric.set_outputs_for_simulation(df_output_meter=df_meters_sel)\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# 6. Define ACCIM custom-model parameters\\n\",\n",
    "    \"Define parameters to match the optimization configuration.\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"parametric.get_available_parameters()\\n\",\n",
    "    \"\\n\",\n",
    "    \"accis_parameters = {\\n\",\n",
    "    \"    \\\"CustAST_m\\\": (0.01, 0.99),\\n\",\n",
    "    \"    \\\"CustAST_n\\\": (5, 23),\\n\",\n",
    "    \"    \\\"CustAST_ASToffset\\\": (1.5, 5),\\n\",\n",
    "    \"    \\\"CustAST_ASTall\\\": (8, 16),\\n\",\n",
    "    \"    \\\"CustAST_ASTaul\\\": (28, 38),\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"parametric.set_parameters(accis_params_dict=accis_parameters)\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# 7. Define the optimisation problem\\n\",\n",
    "    \"Define the objectives to minimize.\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"parametric.set_problem(minimize_outputs=[True, True])\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# 8. Load previous optimisation results\\n\",\n",
    "    \"We load the results from the pickle file. If no specific file is provided, it automatically finds and loads the latest pickle file in `OUT_DIR`.\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"if OPTIMISATION_PICKLE is None:\\n\",\n",
    "    \"    optimisation_files = sorted(Path(OUT_DIR).glob(\\\"outputs_optimisation_*.pkl\\\"))\\n\",\n",
    "    \"    if not optimisation_files:\\n\",\n",
    "    \"        raise FileNotFoundError(\\n\",\n",
    "    \"            \\\"No optimisation pickle was provided and none was found in OUT_DIR.\\\"\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"    OPTIMISATION_PICKLE = str(optimisation_files[-1])\\n\",\n",
    "    \"\\n\",\n",
    "    \"outputs_optimisation = parametric.load_outputs_optimisation(\\n\",\n",
    "    \"    pickle_path=OPTIMISATION_PICKLE,\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Loaded optimisation pickle:\\\", OPTIMISATION_PICKLE)\\n\",\n",
    "    \"print(\\\"Optimisation rows:\\\", len(outputs_optimisation))\\n\",\n",
    "    \"print(\\\"Optimisation CSV:\\\", parametric.outputs_optimisation_filepath)\\n\",\n",
    "    \"\\n\",\n",
    "    \"outputs_optimisation.head()\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# 9. Inspect the Pareto flag\\n\",\n",
    "    \"Check the count of Pareto-optimal and dominated solutions.\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"parametric.outputs_optimisation[\\\"pareto-optimal\\\"].value_counts()\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# 10. MCDM: best compromise solutions\\n\",\n",
    "    \"Find the best compromise solutions using Knee Point and TOPSIS methods.\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"mcdm_df = parametric.plot_best_compromise_solutions(\\n\",\n",
    "    \"    out_dir=OUT_DIR,\\n\",\n",
    "    \"    mcdm_configs=[\\n\",\n",
    "    \"        {\\\"method\\\": \\\"knee_point\\\"},\\n\",\n",
    "    \"        {\\\"method\\\": \\\"topsis\\\"},\\n\",\n",
    "    \"        {\\\"method\\\": \\\"topsis\\\", \\\"weights\\\": [0.7, 0.3], \\\"label\\\": \\\"topsis_w70_30\\\"},\\n\",\n",
    "    \"    ],\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"mcdm_df\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# 11. Pareto-front and parameter-space plots\\n\",\n",
    "    \"Generate visual plots to analyze the trade-offs and parameter spaces.\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"parametric.plot_pareto_front(\\n\",\n",
    "    \"    out_dir=OUT_DIR,\\n\",\n",
    "    \"    color_by=\\\"CustAST_ASToffset\\\",\\n\",\n",
    "    \"    size_by=\\\"CustAST_m\\\",\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"parametric.plot_parallel_coordinates(out_dir=OUT_DIR)\\n\",\n",
    "    \"parametric.plot_pairwise_scatter_matrix(out_dir=OUT_DIR)\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# 12. Optional clustering of Pareto-optimal solutions\\n\",\n",
    "    \"Group Pareto-optimal designs using KMeans.\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"pareto_count = int(parametric.outputs_optimisation[\\\"pareto-optimal\\\"].sum())\\n\",\n",
    "    \"\\n\",\n",
    "    \"if pareto_count >= 2:\\n\",\n",
    "    \"    outputs_before_clustering = parametric.outputs_optimisation.copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    clustered = parametric.run_clustering(\\n\",\n",
    "    \"        n_clusters=min(3, pareto_count),\\n\",\n",
    "    \"        cluster_by=\\\"parameters\\\",\\n\",\n",
    "    \"        pareto_only=True,\\n\",\n",
    "    \"        out_dir=OUT_DIR,\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    parametric.outputs_optimisation = outputs_before_clustering\\n\",\n",
    "    \"    parametric.outputs_optimisation[\\\"Cluster_ID\\\"] = -1\\n\",\n",
    "    \"    parametric.outputs_optimisation.loc[clustered.index, \\\"Cluster_ID\\\"] = clustered[\\\"Cluster_ID\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    parametric.plot_pareto_front(\\n\",\n",
    "    \"        out_dir=OUT_DIR,\\n\",\n",
    "    \"        color_by=\\\"Cluster_ID\\\",\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print(\\\"Skipping clustering: fewer than 2 Pareto-optimal solutions.\\\")\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# 13. Optional robustness analysis\\n\",\n",
    "    \"Evaluate compromise solutions under alternative weather files (EPWs). Uncomment to run.\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# best_solutions = mcdm_df.drop_duplicates(subset=list(accis_parameters)).head(2)\\n\",\n",
    "    \"#\\n\",\n",
    "    \"# robustness_df = parametric.run_robustness_analysis(\\n\",\n",
    "    \"#     optimal_solutions_df=best_solutions,\\n\",\n",
    "    \"#     epws_robustness=EPW_LIST,\\n\",\n",
    "    \"#     out_dir=f\\\"{OUT_DIR}_robustness\\\",\\n\",\n",
    "    \"# )\\n\",\n",
    "    \"#\\n\",\n",
    "    \"# robustness_df.head()\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# 14. Optional Morris sensitivity analysis\\n\",\n",
    "    \"Conduct sensitivity analysis using a separate Morris sample. Uncomment to run.\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# parametric.sampling_morris(num_samples=3, num_levels=4)\\n\",\n",
    "    \"#\\n\",\n",
    "    \"# outputs_parametric_sa = parametric.run_parametric_simulation(\\n\",\n",
    "    \"#     epws=EPW_LIST,\\n\",\n",
    "    \"#     out_dir=f\\\"{OUT_DIR}_sensitivity\\\",\\n\",\n",
    "    \"#     df=parametric.parameters_values_df,\\n\",\n",
    "    \"#     processes=PROCESSES,\\n\",\n",
    "    \"#     keep_dirs=False,\\n\",\n",
    "    \"# )\\n\",\n",
    "    \"#\\n\",\n",
    "    \"# sensitivity_results = parametric.run_sensitivity_analysis_by_epw(\\n\",\n",
    "    \"#     method=\\\"morris\\\",\\n\",\n",
    "    \"#     out_dir=f\\\"{OUT_DIR}_sensitivity\\\",\\n\",\n",
    "    \"#     num_levels=4,\\n\",\n",
    "    \"# )\\n\"\n",
    "   ]\n",
    "  }\n",
    " ],\n",
    " \"metadata\": {\n",
    "  \"kernelspec\": {\n",
