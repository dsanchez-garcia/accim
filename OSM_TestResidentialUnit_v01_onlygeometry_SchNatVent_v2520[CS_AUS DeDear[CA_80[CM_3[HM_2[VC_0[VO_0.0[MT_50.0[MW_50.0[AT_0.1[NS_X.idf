    set ACSTx2 = ACST*SetpointAcc,    !- Program Line 2181
    set AHSTx2 = AHST*SetpointAcc,    !- Program Line 2182
    set roundedACSTx2 = @Round ACSTx2,    !- Program Line 2183
    set roundedAHSTx2 = @Round AHSTx2,    !- Program Line 2184
    if roundedACSTx2 - ACSTx2 < 0,    !- Program Line 2185
