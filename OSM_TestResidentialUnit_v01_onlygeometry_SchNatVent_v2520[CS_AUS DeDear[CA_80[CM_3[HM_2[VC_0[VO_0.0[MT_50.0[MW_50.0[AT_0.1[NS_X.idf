ENERGYMANAGEMENTSYSTEM:PROGRAM,
    SetASTnoTol,              !- Name
    set ACSTnoTol = ACST-ACSTtol,    !- Program Line 1
    set AHSTnoTol = AHST-AHSTtol;    !- Program Line 2

ENERGYMANAGEMENTSYSTEM:PROGRAM,
    CountHoursNoApp_Floor_1_Residential_Living_Occupants,    !- Name
    if (Floor_1_Residential_Living_Occupants_OpT <= ACSTnoTol),    !- Program Line 1
    if (Floor_1_Residential_Living_Occupants_OpT >= AHSTnoTol),    !- Program Line 2
    set ComfHoursNoApp_Floor_1_Residential_Living_Occupants = 1*ZoneTimeStep,    !- Program Line 3
    if Occ_count_Floor_1_Residential_Living_Occupants,    !- Program Line 4
    set OccComfHoursNoApp_Floor_1_Residential_Living_Occupants = 1*ZoneTimeStep,    !- Program Line 5
    else,                     !- Program Line 6
    set OccComfHoursNoApp_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 7
    endif,                    !- Program Line 8
    else,                     !- Program Line 9
    set ComfHoursNoApp_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 10
    endif,                    !- Program Line 11
    else,                     !- Program Line 12
    set ComfHoursNoApp_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 13
    endif,                    !- Program Line 14
    if Floor_1_Residential_Living_Occupants_OpT > ACSTnoTol || Floor_1_Residential_Living_Occupants_OpT < AHSTnoTol,    !- Program Line 15
    if Occ_count_Floor_1_Residential_Living_Occupants,    !- Program Line 16
    set OccDiscomfHoursNoApp_Floor_1_Residential_Living_Occupants = 1*ZoneTimeStep,    !- Program Line 17
    else,                     !- Program Line 18
    set OccDiscomfHoursNoApp_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 19
    endif,                    !- Program Line 20
    else,                     !- Program Line 21
    set OccDiscomfHoursNoApp_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 22
    endif,                    !- Program Line 23
    if Occ_count_Floor_1_Residential_Living_Occupants > 0,    !- Program Line 24
    set OccHours_Floor_1_Residential_Living_Occupants = 1*ZoneTimeStep,    !- Program Line 25
    else,                     !- Program Line 26
    set OccHours_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 27
    endif;                    !- Program Line 28

ENERGYMANAGEMENTSYSTEM:PROGRAM,
