ENERGYMANAGEMENTSYSTEM:PROGRAM,
    SetInputData,             !- Name
    set ComfStand = 14,       !- Program Line 1
    set CAT = 80,             !- Program Line 2
    set ComfMod = 3,          !- Program Line 3
    set HVACmode = 2,         !- Program Line 4
    set VentCtrl = 0,         !- Program Line 5
    set VSToffset = 0.0,      !- Program Line 6
    set MinOToffset = 50.0,    !- Program Line 7
    set MaxWindSpeed = 50.0,    !- Program Line 8
    set ACSTtol = -0.1,       !- Program Line 9
    set AHSTtol = 0.1,        !- Program Line 10
    set CoolSeasonStart = 121,    !- Program Line 11
    set CoolSeasonEnd = 274;    !- Program Line 12

ENERGYMANAGEMENTSYSTEM:PROGRAM,
    SetVOFinputData,          !- Name
    set MaxTempDiffVOF = 6,    !- Program Line 1
    set MinTempDiffVOF = 1,    !- Program Line 2
    set MultiplierVOF = 0.25;    !- Program Line 3

ENERGYMANAGEMENTSYSTEM:PROGRAM,
    SetVST,                   !- Name
    set MinOutTemp = roundedAHST - MinOToffset,    !- Program Line 1
    if (VentCtrl == 0) || (VentCtrl==2),    !- Program Line 2
    if ComfStand == 0,        !- Program Line 3
    if (CurrentTime < 7),     !- Program Line 4
    set VST = (roundedACST+roundedAHST)/2+VSToffset,    !- Program Line 5
    elseif (CurrentTime < 15),    !- Program Line 6
    set VST = 22.5+VSToffset,    !- Program Line 7
    elseif (CurrentTime < 23),    !- Program Line 8
    set VST = (roundedACST+roundedAHST)/2+VSToffset,    !- Program Line 9
    elseif (CurrentTime < 24),    !- Program Line 10
    set VST = (roundedACST+roundedAHST)/2+VSToffset,    !- Program Line 11
    endif,                    !- Program Line 12
    elseif ComfStand == 1 || ComfStand == 10,    !- Program Line 13
    if (RMOT >= AHSTall) && (RMOT <= ACSTaul),    !- Program Line 14
    set VST = ComfTemp+VSToffset,    !- Program Line 15
    else,                     !- Program Line 16
    set VST = (roundedACST+roundedAHST)/2+VSToffset,    !- Program Line 17
    endif,                    !- Program Line 18
    elseif ComfStand == 4 || ComfStand == 5 || ComfStand == 6,    !- Program Line 19
    if (PMOT >= AHSTall) && (PMOT <= ACSTaul),    !- Program Line 20
    set VST = (roundedACST+roundedAHST)/2+VSToffset,    !- Program Line 21
    else,                     !- Program Line 22
    set VST = 0,              !- Program Line 23
    endif,                    !- Program Line 24
    else,                     !- Program Line 25
    if (PMOT >= AHSTall) && (PMOT <= ACSTaul),    !- Program Line 26
    set VST = ComfTemp+VSToffset,    !- Program Line 27
    else,                     !- Program Line 28
    set VST = (roundedACST+roundedAHST)/2+VSToffset,    !- Program Line 29
    endif,                    !- Program Line 30
    endif,                    !- Program Line 31
    elseif (VentCtrl == 1) || (VentCtrl==3),    !- Program Line 32
    set VST = roundedAHST+VSToffset,    !- Program Line 33
    endif;                    !- Program Line 34

ENERGYMANAGEMENTSYSTEM:PROGRAM,
    ApplyAST_Floor_1_Residential_Living_Occupants,    !- Name
    if Floor_1_Residential_Living_Occupants_CoolCoil==0,    !- Program Line 1
    if Floor_1_Residential_Living_Occupants_HeatCoil==0,    !- Program Line 2
    set NoH_NoC_reqs = 1,     !- Program Line 3
    else,                     !- Program Line 4
    set NoH_NoC_reqs = 0,     !- Program Line 5
    endif,                    !- Program Line 6
    else,                     !- Program Line 7
    set NoH_NoC_reqs = 0,     !- Program Line 8
    endif,                    !- Program Line 9
    if Floor_1_Residential_Living_Occupants_OpT<roundedACST,    !- Program Line 10
    if Floor_1_Residential_Living_Occupants_WindSpeed <= MaxWindSpeed,    !- Program Line 11
    if Floor_1_Residential_Living_Occupants_OutT>MinOutTemp,    !- Program Line 12
    if Floor_1_Residential_Living_Occupants_OutT < Floor_1_Residential_Living_Occupants_OpT,    !- Program Line 13
    set meets_base_reqs = 1,    !- Program Line 14
    else,                     !- Program Line 15
    set meets_base_reqs = 0,    !- Program Line 16
    endif,                    !- Program Line 17
    else,                     !- Program Line 18
    set meets_base_reqs = 0,    !- Program Line 19
    endif,                    !- Program Line 20
    else,                     !- Program Line 21
    set meets_base_reqs = 0,    !- Program Line 22
    endif,                    !- Program Line 23
    else,                     !- Program Line 24
    set meets_base_reqs = 0,    !- Program Line 25
    endif,                    !- Program Line 26
    if (NoH_NoC_reqs == 1) && (meets_base_reqs == 1),    !- Program Line 27
    if Floor_1_Residential_Living_Occupants_OpT>VST,    !- Program Line 28
    set Ventilates_HVACmode2_Floor_1_Residential_Living_Occupants = 1,    !- Program Line 29
    else,                     !- Program Line 30
    set Ventilates_HVACmode2_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 31
    endif,                    !- Program Line 32
    else,                     !- Program Line 33
    set Ventilates_HVACmode2_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 34
    endif,                    !- Program Line 35
    if VentCtrl == 0,         !- Program Line 36
    if Floor_1_Residential_Living_Occupants_OutT < Floor_1_Residential_Living_Occupants_OpT,    !- Program Line 37
    if Floor_1_Residential_Living_Occupants_OutT>MinOutTemp,    !- Program Line 38
    if Floor_1_Residential_Living_Occupants_OpT > VST,    !- Program Line 39
    if Floor_1_Residential_Living_Occupants_WindSpeed <= MaxWindSpeed,    !- Program Line 40
    set Ventilates_HVACmode1_Floor_1_Residential_Living_Occupants = 1,    !- Program Line 41
    else,                     !- Program Line 42
    set Ventilates_HVACmode1_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 43
    endif,                    !- Program Line 44
    else,                     !- Program Line 45
    set Ventilates_HVACmode1_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 46
    endif,                    !- Program Line 47
    else,                     !- Program Line 48
    set Ventilates_HVACmode1_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 49
    endif,                    !- Program Line 50
    else,                     !- Program Line 51
    set Ventilates_HVACmode1_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 52
    endif,                    !- Program Line 53
    elseif VentCtrl == 1,     !- Program Line 54
    if Floor_1_Residential_Living_Occupants_OutT<Floor_1_Residential_Living_Occupants_OpT,    !- Program Line 55
    if Floor_1_Residential_Living_Occupants_OutT>MinOutTemp,    !- Program Line 56
    if Floor_1_Residential_Living_Occupants_OpT > ACSTnoTol,    !- Program Line 57
    if Floor_1_Residential_Living_Occupants_WindSpeed <= MaxWindSpeed,    !- Program Line 58
    set Ventilates_HVACmode1_Floor_1_Residential_Living_Occupants = 1,    !- Program Line 59
    else,                     !- Program Line 60
    set Ventilates_HVACmode1_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 61
    endif,                    !- Program Line 62
    else,                     !- Program Line 63
    set Ventilates_HVACmode1_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 64
    endif,                    !- Program Line 65
    else,                     !- Program Line 66
    set Ventilates_HVACmode1_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 67
    endif,                    !- Program Line 68
    else,                     !- Program Line 69
    set Ventilates_HVACmode1_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 70
    endif,                    !- Program Line 71
    endif,                    !- Program Line 72
    if HVACmode == 0,         !- Program Line 73
    if Occ_count_Floor_1_Residential_Living_Occupants == 0,    !- Program Line 74
    Set ACST_Act_Floor_1_Residential_Living_Occupants = 100,    !- Program Line 75
    Set AHST_Act_Floor_1_Residential_Living_Occupants = -100,    !- Program Line 76
    else,                     !- Program Line 77
    set ACST_Act_Floor_1_Residential_Living_Occupants = roundedACST,    !- Program Line 78
    set AHST_Act_Floor_1_Residential_Living_Occupants = roundedAHST,    !- Program Line 79
    endif,                    !- Program Line 80
    elseif HVACmode == 1,     !- Program Line 81
    Set ACST_Act_Floor_1_Residential_Living_Occupants = 100,    !- Program Line 82
    Set AHST_Act_Floor_1_Residential_Living_Occupants = -100,    !- Program Line 83
