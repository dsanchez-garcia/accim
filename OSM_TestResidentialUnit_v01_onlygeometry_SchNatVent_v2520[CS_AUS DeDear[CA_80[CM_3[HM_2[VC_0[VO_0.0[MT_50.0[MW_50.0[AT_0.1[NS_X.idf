ENERGYMANAGEMENTSYSTEM:PROGRAM,
    SetComfTemp,              !- Name
    if ComfStand == 99,       !- Program Line 1
    set ComfTemp = PMOT*m+n,    !- Program Line 2
    elseif ComfStand == 1,    !- Program Line 3
    set ComfTemp = RMOT*0.33+18.8,    !- Program Line 4
    elseif ComfStand == 2,    !- Program Line 5
    set ComfTemp = PMOT*0.31+17.8,    !- Program Line 6
    elseif ComfStand == 3,    !- Program Line 7
    set ComfTemp = PMOT*0.48+14.4,    !- Program Line 8
    elseif ComfStand == 4,    !- Program Line 9
    set ComfTemp = 0,         !- Program Line 10
    elseif ComfStand == 5,    !- Program Line 11
    set ComfTemp = 0,         !- Program Line 12
    elseif ComfStand == 6,    !- Program Line 13
    set ComfTemp = 0,         !- Program Line 14
    elseif ComfStand == 7,    !- Program Line 15
    set ComfTemp = PMOT*0.54+12.83,    !- Program Line 16
    elseif ComfStand == 8,    !- Program Line 17
    set ComfTemp = PMOT*0.28+17.87,    !- Program Line 18
    elseif ComfStand == 9,    !- Program Line 19
    set ComfTemp = PMOT*0.39+18.42,    !- Program Line 20
    elseif ComfStand == 10,    !- Program Line 21
    set ComfTemp = PMOT*0.42+17.6,    !- Program Line 22
    elseif ComfStand == 11,    !- Program Line 23
    set ComfTemp = PMOT*0.75+5.37,    !- Program Line 24
    elseif ComfStand == 12,    !- Program Line 25
    set ComfTemp = PMOT*0.25+19.7,    !- Program Line 26
    elseif ComfStand == 13,    !- Program Line 27
    set ComfTemp = PMOT*0.26+15.9,    !- Program Line 28
    elseif ComfStand == 14,    !- Program Line 29
    set ComfTemp = PMOT*0.26+16.75,    !- Program Line 30
    elseif ComfStand == 15,    !- Program Line 31
    set ComfTemp = PMOT*0.56+12.74,    !- Program Line 32
    elseif ComfStand == 16,    !- Program Line 33
    set ComfTemp = PMOT*0.09+22.32,    !- Program Line 34
    elseif ComfStand == 17,    !- Program Line 35
    if (DayOfYear <= 121) || (DayOfYear > 295),    !- Program Line 36
    set ComfTemp = PMOT*0.48+13.9,    !- Program Line 37
    else,                     !- Program Line 38
    set ComfTemp = PMOT*0.59+9.6,    !- Program Line 39
    endif,                    !- Program Line 40
    elseif ComfStand == 18,    !- Program Line 41
    if (DayOfYear <= 121) || (DayOfYear > 295),    !- Program Line 42
    set ComfTemp = PMOT*0.84+5.3,    !- Program Line 43
    else,                     !- Program Line 44
    set ComfTemp = PMOT*0.96-3.6,    !- Program Line 45
    endif,                    !- Program Line 46
    elseif ComfStand == 19,    !- Program Line 47
    if (DayOfYear <= 121) || (DayOfYear > 295),    !- Program Line 48
    set ComfTemp = PMOT*0.27+17.9,    !- Program Line 49
    else,                     !- Program Line 50
    set ComfTemp = PMOT*0.53+10.3,    !- Program Line 51
    endif,                    !- Program Line 52
    elseif ComfStand == 20,    !- Program Line 53
    if (DayOfYear <= 121) || (DayOfYear > 295),    !- Program Line 54
    set ComfTemp = PMOT*0.38+15.7,    !- Program Line 55
    else,                     !- Program Line 56
    set ComfTemp = PMOT*0.47+9.07,    !- Program Line 57
    endif,                    !- Program Line 58
    elseif ComfStand == 21,    !- Program Line 59
    set ComfTemp = PMOT*0.678+13.51,    !- Program Line 60
    endif;                    !- Program Line 61

ENERGYMANAGEMENTSYSTEM:PROGRAM,
    CountHours_Floor_1_Residential_Living_Occupants,    !- Name
    if (ComfStand == 1) || (ComfStand == 10),    !- Program Line 1
    if (RMOT >= AHSTall) && (RMOT <= ACSTaul),    !- Program Line 2
    if (Floor_1_Residential_Living_Occupants_OpT <= ACSTnoTol),    !- Program Line 3
    if (Floor_1_Residential_Living_Occupants_OpT >= AHSTnoTol),    !- Program Line 4
    set ComfHours_Floor_1_Residential_Living_Occupants = 1*ZoneTimeStep,    !- Program Line 5
    set DiscomfAppHotHours_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 6
    set DiscomfAppColdHours_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 7
    set DiscomfNonAppHotHours_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 8
    set DiscomfNonAppColdHours_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 9
    endif,                    !- Program Line 10
    elseif (Floor_1_Residential_Living_Occupants_OpT > ACSTnoTol),    !- Program Line 11
    set ComfHours_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 12
    set DiscomfAppHotHours_Floor_1_Residential_Living_Occupants = 1*ZoneTimeStep,    !- Program Line 13
    set DiscomfAppColdHours_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 14
    set DiscomfNonAppHotHours_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 15
    set DiscomfNonAppColdHours_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 16
    elseif (Floor_1_Residential_Living_Occupants_OpT < AHSTnoTol),    !- Program Line 17
    set ComfHours_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 18
    set DiscomfAppHotHours_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 19
    set DiscomfAppColdHours_Floor_1_Residential_Living_Occupants = 1*ZoneTimeStep,    !- Program Line 20
    set DiscomfNonAppHotHours_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 21
    set DiscomfNonAppColdHours_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 22
    endif,                    !- Program Line 23
    elseif (RMOT > ACSTaul),    !- Program Line 24
    set ComfHours_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 25
    set DiscomfAppHotHours_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 26
    set DiscomfAppColdHours_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 27
    set DiscomfNonAppHotHours_Floor_1_Residential_Living_Occupants = 1*ZoneTimeStep,    !- Program Line 28
    set DiscomfNonAppColdHours_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 29
    elseif (RMOT < AHSTall),    !- Program Line 30
    set ComfHours_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 31
    set DiscomfAppHotHours_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 32
    set DiscomfAppColdHours_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 33
    set DiscomfNonAppHotHours_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 34
    set DiscomfNonAppColdHours_Floor_1_Residential_Living_Occupants = 1*ZoneTimeStep,    !- Program Line 35
    endif,                    !- Program Line 36
    else,                     !- Program Line 37
    if (PMOT >= AHSTall) && (PMOT <= ACSTaul),    !- Program Line 38
    if (Floor_1_Residential_Living_Occupants_OpT <= ACSTnoTol),    !- Program Line 39
    if (Floor_1_Residential_Living_Occupants_OpT >= AHSTnoTol),    !- Program Line 40
    set ComfHours_Floor_1_Residential_Living_Occupants = 1*ZoneTimeStep,    !- Program Line 41
    set DiscomfAppHotHours_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 42
    set DiscomfAppColdHours_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 43
    set DiscomfNonAppHotHours_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 44
    set DiscomfNonAppColdHours_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 45
    endif,                    !- Program Line 46
    elseif (Floor_1_Residential_Living_Occupants_OpT > ACSTnoTol),    !- Program Line 47
    set ComfHours_Floor_1_Residential_Living_Occupants = 0,    !- Program Line 48
