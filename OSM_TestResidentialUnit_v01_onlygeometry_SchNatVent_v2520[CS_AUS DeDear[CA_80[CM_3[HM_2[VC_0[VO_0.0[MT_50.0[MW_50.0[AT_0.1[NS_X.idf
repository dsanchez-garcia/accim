ENERGYMANAGEMENTSYSTEM:PROGRAM,
    SetMyVOF_Floor_1_Zone_Win,    !- Name
    set slope = (1 - MultiplierVOF) / (MinTempDiffVOF - MaxTempDiffVOF),    !- Program Line 1
    if Floor_1_Zone_Win_OutT > 0,    !- Program Line 2
    set Floor_1_Zone_Win_TempDiffVOF = Floor_1_Zone_Win_OpT - Floor_1_Zone_Win_OutT,    !- Program Line 3
    else,                     !- Program Line 4
    set Floor_1_Zone_Win_TempDiffVOF = Floor_1_Zone_Win_OpT + Floor_1_Zone_Win_OutT,    !- Program Line 5
    endif,                    !- Program Line 6
    if Floor_1_Zone_Win_OutT > Floor_1_Zone_Win_OpT,    !- Program Line 7
    set Floor_1_Zone_Win_MyVOF = 0,    !- Program Line 8
    else,                     !- Program Line 9
    if Floor_1_Zone_Win_TempDiffVOF > MaxTempDiffVOF,    !- Program Line 10
    set Floor_1_Zone_Win_MyVOF = MultiplierVOF,    !- Program Line 11
    elseif Floor_1_Zone_Win_TempDiffVOF < MinTempDiffVOF,    !- Program Line 12
    set Floor_1_Zone_Win_MyVOF = 1.0,    !- Program Line 13
    else,                     !- Program Line 14
    set Floor_1_Zone_Win_MyVOF = slope*Floor_1_Zone_Win_TempDiffVOF - slope*MinTempDiffVOF + 1,    !- Program Line 15
    endif,                    !- Program Line 16
    endif;                    !- Program Line 17

