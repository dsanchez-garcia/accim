    if BR1_People_HeatCoil==0,    !- Program Line 2
    set NoH_NoC_reqs = 1,     !- Program Line 3
    else,                     !- Program Line 4
    set NoH_NoC_reqs = 0,     !- Program Line 5
    endif,                    !- Program Line 6
    else,                     !- Program Line 7
    set NoH_NoC_reqs = 0,     !- Program Line 8
    endif,                    !- Program Line 9
    if BR1_People_OpT<roundedACST,    !- Program Line 10
    if BR1_People_WindSpeed <= MaxWindSpeed,    !- Program Line 11
    if BR1_People_OutT>MinOutTemp,    !- Program Line 12
    if BR1_People_OutT < BR1_People_OpT,    !- Program Line 13
    set meets_base_reqs = 1,    !- Program Line 14
    else,                     !- Program Line 15
    set meets_base_reqs = 0,    !- Program Line 16
    endif,                    !- Program Line 17
    else,                     !- Program Line 18
    set meets_base_reqs = 0,    !- Program Line 19
    endif,                    !- Program Line 20
    else,                     !- Program Line 21
    set meets_base_reqs = 0,    !- Program Line 22
    endif,                    !- Program Line 23
    else,                     !- Program Line 24
    set meets_base_reqs = 0,    !- Program Line 25
    endif,                    !- Program Line 26
    if (NoH_NoC_reqs == 1) && (meets_base_reqs == 1),    !- Program Line 27
    if BR1_People_OpT>VST,    !- Program Line 28
    set Ventilates_HVACmode2_BR1_People = 1,    !- Program Line 29
    else,                     !- Program Line 30
    set Ventilates_HVACmode2_BR1_People = 0,    !- Program Line 31
    endif,                    !- Program Line 32
    else,                     !- Program Line 33
    set Ventilates_HVACmode2_BR1_People = 0,    !- Program Line 34
    endif,                    !- Program Line 35
    if VentCtrl == 0,         !- Program Line 36
    if BR1_People_OutT < BR1_People_OpT,    !- Program Line 37
    if BR1_People_OutT>MinOutTemp,    !- Program Line 38
    if BR1_People_OpT > VST,    !- Program Line 39
    if BR1_People_WindSpeed <= MaxWindSpeed,    !- Program Line 40
    set Ventilates_HVACmode1_BR1_People = 1,    !- Program Line 41
    else,                     !- Program Line 42
    set Ventilates_HVACmode1_BR1_People = 0,    !- Program Line 43
    endif,                    !- Program Line 44
    else,                     !- Program Line 45
    set Ventilates_HVACmode1_BR1_People = 0,    !- Program Line 46
    endif,                    !- Program Line 47
    else,                     !- Program Line 48
    set Ventilates_HVACmode1_BR1_People = 0,    !- Program Line 49
    endif,                    !- Program Line 50
    else,                     !- Program Line 51
    set Ventilates_HVACmode1_BR1_People = 0,    !- Program Line 52
    endif,                    !- Program Line 53
    elseif VentCtrl == 1,     !- Program Line 54
    if BR1_People_OutT<BR1_People_OpT,    !- Program Line 55
    if BR1_People_OutT>MinOutTemp,    !- Program Line 56
    if BR1_People_OpT > ACSTnoTol,    !- Program Line 57
    if BR1_People_WindSpeed <= MaxWindSpeed,    !- Program Line 58
    set Ventilates_HVACmode1_BR1_People = 1,    !- Program Line 59
    else,                     !- Program Line 60
    set Ventilates_HVACmode1_BR1_People = 0,    !- Program Line 61
    endif,                    !- Program Line 62
    else,                     !- Program Line 63
    set Ventilates_HVACmode1_BR1_People = 0,    !- Program Line 64
    endif,                    !- Program Line 65
    else,                     !- Program Line 66
    set Ventilates_HVACmode1_BR1_People = 0,    !- Program Line 67
    endif,                    !- Program Line 68
    else,                     !- Program Line 69
    set Ventilates_HVACmode1_BR1_People = 0,    !- Program Line 70
    endif,                    !- Program Line 71
    endif,                    !- Program Line 72
    if HVACmode == 0,         !- Program Line 73
    if Occ_count_BR1_People == 0,    !- Program Line 74
    Set ACST_Act_BR1_People = 100,    !- Program Line 75
    Set AHST_Act_BR1_People = -100,    !- Program Line 76
    else,                     !- Program Line 77
    set ACST_Act_BR1_People = roundedACST,    !- Program Line 78
    set AHST_Act_BR1_People = roundedAHST,    !- Program Line 79
    endif,                    !- Program Line 80
    elseif HVACmode == 1,     !- Program Line 81
    Set ACST_Act_BR1_People = 100,    !- Program Line 82
    Set AHST_Act_BR1_People = -100,    !- Program Line 83
    if Ventilates_HVACmode1_BR1_People == 1 && Occ_count_BR1_People > 0,    !- Program Line 84
    set VentHours_BR1_People = 1*ZoneTimeStep,    !- Program Line 85
    else,                     !- Program Line 86
    set VentHours_BR1_People = 0,    !- Program Line 87
    endif,                    !- Program Line 88
    elseif HVACmode == 2,     !- Program Line 89
    if Occ_count_BR1_People == 0,    !- Program Line 90
    Set ACST_Act_BR1_People = 100,    !- Program Line 91
    Set AHST_Act_BR1_People = -100,    !- Program Line 92
    set VentHours_BR1_People = 0,    !- Program Line 93
    else,                     !- Program Line 94
    if Ventilates_HVACmode2_BR1_People == 1,    !- Program Line 95
    set VentHours_BR1_People = 1*ZoneTimeStep,    !- Program Line 96
    elseif Ventilates_HVACmode2_BR1_People == 0,    !- Program Line 97
    set VentHours_BR1_People = 0,    !- Program Line 98
    set ACST_Act_BR1_People = roundedACST,    !- Program Line 99
    set AHST_Act_BR1_People = roundedAHST,    !- Program Line 100
    endif,                    !- Program Line 101
    endif,                    !- Program Line 102
    endif;                    !- Program Line 103

